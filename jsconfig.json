{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022"
  },
  "include": [
    "app/**/*.js",
    "app/**/*.jsx",
    "components/**/*.jsx",
    "data/**/*.js",
    "lib/**/*.js"
  ],
  "exclude": ["node_modules", ".next"]
}
